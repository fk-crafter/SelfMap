{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://selfmap-bck.onrender.com/api/:match*"
    },
    {
      "source": "/users/:match*",
      "destination": "https://selfmap-bck.onrender.com/users/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
